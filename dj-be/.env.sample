IDENTITY_PROVIDER=KEYCLOACK
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/protocol/openid-connect/token/introspect"
OIDC_AUTHORIZATION_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/protocol/openid-connect/auth"
OIDC_TOKEN_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/protocol/openid-connect/token"
OIDC_JWKS_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/protocol/openid-connect/certs"
OIDC_CONFIGURATION_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/.well-known/openid-configuration"
OIDC_USERINFO_ENDPOINT="https://id.www.surveydesigner.vam.wfp.org/realms/survey-designer/protocol/openid-connect/userinfo"
OIDC_CALLBACK_URL="http://localhost:8080/auth/callback/"
FRONTEND_BASE_DOMAIN="https://dev.surveydesigner.vam.wfp.org/"

#Clarity
VITE_CLARITY_PROJECT_ID_DEV=
VITE_CLARITY_PROJECT_ID_PROD=
