# Safe local/CI defaults for the Docker Compose E2E stack.
DJANGO_SETTINGS_MODULE=survey_designer.settings
SECRET_KEY=not-a-secret-e2e-key
DEBUG=true
ALLOWED_HOSTS=localhost;127.0.0.1;api
CORS_ALLOWED_ORIGINS="http://localhost:3000;http://localhost:3002"
ENV=ci
ENABLE_E2E_AUTH=true
E2E_AUTH_TOKEN=change-me-for-e2e
FRONTEND_BASE_DOMAIN=http://localhost:3000

POSTGRES_USER=postgres
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PASSWORD=r00t
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

SEND_TO_SENTRY=false
SENTRY_DSN=
SENTRY_SAMPLE_RATE=0.001

AWS_ACCESS_KEY_ID=dev_user
AWS_SECRET_ACCESS_KEY=dev_pass
UPLOAD_TO_S3=True
AWS_STORAGE_BUCKET_NAME=media-bucket
AWS_S3_ENDPOINT_URL=http://localhost:9000

EMAIL_HOST=maildev
EMAIL_PORT=1025
EMAIL_HOST_USER=dev
EMAIL_HOST_PASSWORD=dev
EMAIL_USE_TLS=False

IDENTITY_PROVIDER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ENDPOINT=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_ENDPOINT=
OIDC_CONFIGURATION_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_CALLBACK_URL=http://localhost:8080/auth/callback/
